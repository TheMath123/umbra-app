{
  "name": "umbra",
  "version": "0.1.0",
  "description": "Umbra — leitor e editor de Markdown leve e rápido",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
